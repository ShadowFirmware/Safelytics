# Copia a .env y ajusta valores.

DATABASE_URL=mysql://Luis:pablito2907@localhost/safelytic
JWT_SECRET=
# 32 bytes en hexadecimal (64 caracteres). Obligatorio para cifrar claves Stellar en BD.
# Generar: openssl rand -hex 32   (o PowerShell: -join ((1..32)|%{ '{0:x2}' -f (Get-Random -Max 256) }))
# El valor real solo en .env (este archivo se sube a git; déjalo vacío aquí).
KEY_ENCRYPTION_SECRET=

STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Usa comillas: el `;` sin comillas rompe el parseo del .env (se interpreta como comentario).
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Activo MXNe (testnet): clave pública del EMISOR
MXNE_ASSET_CODE=MXNe
MXNE_ISSUER=G...

# Secreto S... del MISMO emisor — necesario para el faucet en la app (POST /api/wallet/faucet-mxne)
# ⚠️ Nunca uses un secreto de mainnet aquí. Solo testnet.
MXNE_ISSUER_SECRET=S...

HOST=0.0.0.0
PORT=8080
PLATFORM_FEE_BPS=50
# MXN por 1 USDC — solo para cotización / UX (equivalente referencial)
REFERENCE_MXN_PER_USDC=17.5
# Wallet G... que recibe la comisión en MXNe (misma trustline). Requerida para split on-chain si fee_bps > 0.
PLATFORM_FEE_RECEIVER=G...
